# ============================================================
# Uri Herbs Workshop — Environment Variables
# Copy to .env.local for Next.js (never commit the real file)
# ============================================================

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER-SIDE ONLY, never expose to browser
# Used only in admin API routes / Edge Functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — resend.com/api-keys (for confirmation emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# WhatsApp Business number (E.164, no +, no spaces)
# Used to build wa.me click-to-chat links
NEXT_PUBLIC_WHATSAPP_NUMBER=66812345678

# Google Places API (New) — Google Maps reviews on Home + /book.
# SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix, never sent to the browser).
# Key should be restricted to "Places API (New)" in Google Cloud.
# Place ID: run `node scripts/find-place-id.mjs` once to look it up.
# If either is missing, the reviews section simply doesn't render.
GOOGLE_PLACES_API_KEY=your-places-api-key
GOOGLE_PLACE_ID=ChIJxxxxxxxxxxxxxxxxxxxxxxxxx
