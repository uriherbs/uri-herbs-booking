# ============================================================
# Uri Herbs Workshop — Environment Variables
# Copy to .env.local for Next.js (never commit the real file)
# ============================================================

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER-SIDE ONLY, never expose to browser
# Used only in admin API routes / Edge Functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — resend.com/api-keys (for confirmation emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# WhatsApp Business number (E.164, no +, no spaces)
# Used to build wa.me click-to-chat links
NEXT_PUBLIC_WHATSAPP_NUMBER=66812345678
